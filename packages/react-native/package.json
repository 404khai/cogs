{
  "name": "@cogs/react-native",
  "version": "0.1.0",
  "description": "Cogs for React Native: parametric robot avatars with 20 chassis, 12 expressions and 8 display modes, drawn with react-native-svg and built from cog JSON.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/404khai/cogs.git", "directory": "packages/react-native" },
  "homepage": "https://github.com/404khai/cogs/tree/main/packages/react-native#readme",
  "keywords": ["react-native", "expo", "avatar", "robot", "svg", "bot", "agent", "cogs"],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "preview": "bun scripts/preview.tsx",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-svg": "^15.16.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}
